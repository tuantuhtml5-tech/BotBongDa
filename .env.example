# Never commit real values. Obtain token from @BotFather; send /start to your bot.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID AND private chat ID (usually identical).
TELEGRAM_USER_ID=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
# Configurable; must support Responses API + web_search.
OPENAI_MODEL=gpt-6-astra
# Generate two DIFFERENT secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBS_SECRET=
WEBHOOK_SECRET=
BOT_BASE_URL=https://YOUR-HOST.example
DB_PATH=/data/bot.sqlite3
PORT=8080
# Hard cap on API requests, NOT a dollar spending cap; set a budget on API account too.
MAX_API_CALLS_PER_DAY=30
# Scheduled reports are saved silently by default. Chat commands always reply.
NOTIFY_REPORTS=false
MAX_PICKS=3
MAX_REVIEW_BATCH=3
